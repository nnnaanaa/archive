; --- 1. 定義ファイルの読み込み ---
; マクロ自身のフォルダパスを取得
getdir MACRO_DIR

; 定義ファイル(config.txt)のフルパスを組み立て
CONFIG_FILE = MACRO_DIR
strconcat CONFIG_FILE '\config.txt'

; 変数の初期化
HOST_IP   = ''
USER_NAME = ''
PASS_WORD = ''

; フルパスでファイルを開く
fileopen fhandle CONFIG_FILE 0
if fhandle == -1 then
    messagebox 'config.txt が開けませんでした。マクロと同じフォルダにファイルがあるか確認してください。' 'Error'
    end
endif

:config_loop
filereadln fhandle line
if result == 1 goto config_close

; 空行はスキップ
strlen line
if result == 0 goto config_loop

; 改行コード(CR/LF)を先に除去
strreplace line 1 #13 ''
strreplace line 1 #10 ''

; --- 【修正】strfindを使わず、strsplitで安全に分割 ---
; 「=」の前後で文字列を2つに一発分割します（groupmatchstr1に左側、groupmatchstr2に右側が入ります）
strsplit line '=' 2

; 分割に失敗（= が含まれていない行）した場合はスキップ
if result <= 0 goto config_loop

key_name = groupmatchstr1
val_data = groupmatchstr2

; 前後の余計なスペースを除去
strtrim val_data ' '
strtrim key_name ' '

; 各変数への格納（strcompareで大文字小文字を区別せず完全一致判定）
strcompare key_name 'HOST_IP'
if result == 0 HOST_IP = val_data

strcompare key_name 'USER_NAME'
if result == 0 USER_NAME = val_data

strcompare key_name 'PASS_WORD'
if result == 0 PASS_WORD = val_data

goto config_loop

:config_close
fileclose fhandle

; 必要な設定がすべて読み込めたかチェック
strlen HOST_IP
if result == 0 goto config_error
strlen USER_NAME
if result == 0 goto config_error
strlen PASS_WORD
if result == 0 goto config_error
goto config_ok

:config_error
messagebox 'config.txt の読み込みに失敗しました。HOST_IP, USER_NAME, PASS_WORD の記述を確認してください。' 'Error'
end

:config_ok
; コマンドフォルダの階層は固定
CMD_DIR = 'P:\teraterm\command'

; --- 2. サーバへ接続 ---
COMMAND = HOST_IP
strconcat COMMAND ':22 /ssh /2 /auth=password /user='
strconcat COMMAND USER_NAME
strconcat COMMAND ' /passwd='
strconcat COMMAND PASS_WORD

connect COMMAND
wait '$' '#' '>'

; --- 3. コマンドファイル一覧の取得 ---
setdir CMD_DIR

; ファイルリストを作成（最大9個まで）
strdim file_list 10
i = 0

findfirst fhandle '*.txt' filename
while result
    file_list[i] = filename
    i = i + 1
    if i >= 10 break
    findnext fhandle filename
endwhile
findclose fhandle

; --- 4. listboxでファイルを選択 ---
listbox '実行するファイルを選択してください' 'コマンド選択' file_list

; キャンセル（result = -1）された場合は終了
if result == -1 then
    end
endif

; 選択されたファイル名を取得
selected_index = result
CMD_FILE = file_list[selected_index]

; --- 4.5 実行前のファイル確認処理 ---
; メモ帳起動用のコマンド文字列を組み立てる
NOTEPAD_CMD = 'notepad.exe "'
strconcat NOTEPAD_CMD CMD_DIR
strconcat NOTEPAD_CMD '\'
strconcat NOTEPAD_CMD CMD_FILE
strconcat NOTEPAD_CMD '"'

; メモ帳で選択されたファイルをフルパスで開く
exec NOTEPAD_CMD

; 確実に動く yesnobox を使用
yesnobox '選択されたファイルの中身をメモ帳で開きました。この内容で実行しますか？' '実行確認'

; 「いいえ(No)」が押された場合（result = 0）はマクロを終了する
if result == 0 then
    end
endif

; --- 5. ファイル読み込みと実行（20行ずつ） ---
fileopen fhandle CMD_FILE 0
if fhandle == -1 then
    messagebox 'ファイルを開けませんでした。' 'Error'
    end
endif

count = 0
:loop
filereadln fhandle line
if result == 1 goto fclose

strlen line
if result > 0 then
    sendln line
    wait '$' '#' '>'
    
    count = count + 1
    if count == 20 then
        messagebox '20行送信しました。続けて送信しますか？' '一時停止'
        count = 0
    endif
endif
goto loop

:fclose
fileclose fhandle
messagebox '全コマンドの送信が完了しました。' '完了'