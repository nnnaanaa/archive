; --- 1. 定義ファイルの読み込み ---
getdir MACRO_DIR

CONFIG_FILE = MACRO_DIR
strconcat CONFIG_FILE '\config.txt'

HOST_IP   = ''
USER_NAME = ''
PASS_WORD = ''

fileopen fhandle CONFIG_FILE 0
if fhandle == -1 then
    messagebox 'config.txt が開けませんでした。マクロと同じフォルダにファイルがあるか確認してください。' 'Error'
    end
endif

:config_loop
filereadln fhandle line
if result == 1 goto config_close

strlen line
if result == 0 goto config_loop

strreplace line 1 #13 ''
strreplace line 1 #10 ''

strsplit line '=' 2
if result <= 0 goto config_loop

key_name = groupmatchstr1
val_data = groupmatchstr2

strtrim val_data ' '
strtrim key_name ' '

strcompare key_name 'HOST_IP'
if result == 0 HOST_IP = val_data

strcompare key_name 'USER_NAME'
if result == 0 USER_NAME = val_data

strcompare key_name 'PASS_WORD'
if result == 0 PASS_WORD = val_data

goto config_loop

:config_close
fileclose fhandle

strlen HOST_IP
if result == 0 goto config_error
strlen USER_NAME
if result == 0 goto config_error
strlen PASS_WORD
if result == 0 goto config_error
goto config_ok

:config_error
messagebox 'config.txt の読み込みに失敗しました。HOST_IP, USER_NAME, PASS_WORD の記述を確認してください。' 'Error'
end

:config_ok
CMD_DIR = 'P:\teraterm\command'

; --- 2. サーバへ接続 ---
COMMAND = HOST_IP
strconcat COMMAND ':22 /ssh /2 /auth=password /user='
strconcat COMMAND USER_NAME
strconcat COMMAND ' /passwd='
strconcat COMMAND PASS_WORD

connect COMMAND
wait '$' '#' '>'

; --- 3. コマンドファイル一覧の取得 ---
setdir CMD_DIR

strdim file_list 10
i = 0

findfirst fhandle '*.txt' filename
while result
    file_list[i] = filename
    i = i + 1
    if i >= 10 break
    findnext fhandle filename
endwhile
findclose fhandle

; --- 4. listboxでファイルを選択 ---
listbox '実行するファイルを選択してください' 'コマンド選択' file_list

if result == -1 then
    end
endif

selected_index = result
CMD_FILE = file_list[selected_index]

; ========================================================
; --- 4.5 実行前のファイル確認処理（確認ダイアログ一時停止版） ---
; ========================================================
NOTEPAD_CMD = 'notepad.exe "'
strconcat NOTEPAD_CMD CMD_DIR
strconcat NOTEPAD_CMD '\'
strconcat NOTEPAD_CMD CMD_FILE
strconcat NOTEPAD_CMD '"'

exec NOTEPAD_CMD

messagebox '選択したコマンドファイルをメモ帳で開きました。\n中身を確認し、メモ帳を閉じてから【OK】を押してください。' '確認中（マクロ一時停止）'

yesnobox 'この内容で本当にコマンドを実行しますか？' '実行確認'

if result == 0 then
    end
endif
; ========================================================

; --- 5. ファイル読み込みと実行（20行ずつ） ---
fileopen fhandle CMD_FILE 0
if fhandle == -1 then
    messagebox 'ファイルを開けませんでした。' 'Error'
    end
endif

count = 0
:loop
filereadln fhandle line
if result == 1 goto fclose

strlen line
if result > 0 then
    sendln line
    wait '$' '#' '>'
    
    count = count + 1
    if count == 20 then
        messagebox '20行送信しました。続けて送信しますか？' '一時停止'
        count = 0
    endif
endif
goto loop

:fclose
fileclose fhandle
messagebox '全コマンドの送信が完了しました。' '完了'

; ========================================================
; --- 【追加】6. 完了後に指定のフォルダを自動で開く ---
; ========================================================
; Windowsのエクスプローラーで P:\teraterm\command を開くコマンドを組み立て
EXPLORER_CMD = 'explorer.exe "'
strconcat EXPLORER_CMD CMD_DIR
strconcat EXPLORER_CMD '"'

; コマンドを実行してフォルダーを開く
exec EXPLORER_CMD
; ========================================================