; ============================================
; 10.0.0.18 接続 + 作業グループ別コマンド選択マクロ
; ============================================

HOST_IP   = '10.0.0.18'
USER_NAME = 'nanahira'
PASS_WORD = 'nanahira'

COMMAND = HOST_IP
strconcat COMMAND ':22 /ssh /2 /auth=password /user='
strconcat COMMAND USER_NAME
strconcat COMMAND ' /passwd='
strconcat COMMAND PASS_WORD

connect COMMAND
if result <> 2 then
    messagebox '10.0.0.18 への接続に失敗しました。' 'Error'
    end
endif

wait '$' '#' '>'

; ============================================
; 作業グループ一覧
; ============================================
strdim GROUP_LIST 4
GROUP_LIST[0] = 'ディレクトリ確認'
GROUP_LIST[1] = 'システム情報'
GROUP_LIST[2] = 'ディスク・リソース確認'
GROUP_LIST[3] = 'ネットワーク確認'

; ディレクトリ確認 グループのコマンド
strdim CMD_DIR 4
CMD_DIR[0] = 'pwd'
CMD_DIR[1] = 'ls -la'
CMD_DIR[2] = 'ls -la /var/log'
CMD_DIR[3] = 'du -sh *'

; システム情報 グループのコマンド
strdim CMD_SYS 4
CMD_SYS[0] = 'uname -a'
CMD_SYS[1] = 'hostname'
CMD_SYS[2] = 'whoami'
CMD_SYS[3] = 'uptime'

; ディスク・リソース確認 グループのコマンド
strdim CMD_DISK 4
CMD_DISK[0] = 'df -h'
CMD_DISK[1] = 'free -h'
CMD_DISK[2] = 'top -bn1'
CMD_DISK[3] = 'ps aux'

; ネットワーク確認 グループのコマンド
strdim CMD_NET 4
CMD_NET[0] = 'ip a'
CMD_NET[1] = 'ss -tuln'
CMD_NET[2] = 'netstat -tuln'
CMD_NET[3] = 'ping -c 4 8.8.8.8'

; ============================================
; 作業履歴(サマリー用)
; ============================================
HISTORY_MAX = 200
HISTORY_COUNT = 0
strdim HISTORY_LINES HISTORY_MAX

; ============================================
; メニュー本体
; ============================================
:group_menu
listbox '作業グループを選択してください' '作業グループ' GROUP_LIST

if result == -1 goto show_summary

if result == 0 then
    CURRENT_GROUP = 'ディレクトリ確認'
    goto dir_menu
endif
if result == 1 then
    CURRENT_GROUP = 'システム情報'
    goto sys_menu
endif
if result == 2 then
    CURRENT_GROUP = 'ディスク・リソース確認'
    goto disk_menu
endif
if result == 3 then
    CURRENT_GROUP = 'ネットワーク確認'
    goto net_menu
endif

:dir_menu
listbox '実行するコマンドを選択してください' 'ディレクトリ確認' CMD_DIR
if result == -1 goto group_menu
CURRENT_CMD = CMD_DIR[result]
call run_cmd
goto dir_menu

:sys_menu
listbox '実行するコマンドを選択してください' 'システム情報' CMD_SYS
if result == -1 goto group_menu
CURRENT_CMD = CMD_SYS[result]
call run_cmd
goto sys_menu

:disk_menu
listbox '実行するコマンドを選択してください' 'ディスク・リソース確認' CMD_DISK
if result == -1 goto group_menu
CURRENT_CMD = CMD_DISK[result]
call run_cmd
goto disk_menu

:net_menu
listbox '実行するコマンドを選択してください' 'ネットワーク確認' CMD_NET
if result == -1 goto group_menu
CURRENT_CMD = CMD_NET[result]
call run_cmd
goto net_menu

end

; ============================================
; サブルーチン: コマンド実行 + 履歴記録
; ============================================
:run_cmd
sendln CURRENT_CMD
wait '$' '#' '>'

gettime NOW_TIME "%H:%M:%S"
LOG_LINE = NOW_TIME
strconcat LOG_LINE ' ['
strconcat LOG_LINE CURRENT_GROUP
strconcat LOG_LINE '] '
strconcat LOG_LINE CURRENT_CMD

if HISTORY_COUNT < HISTORY_MAX then
    HISTORY_LINES[HISTORY_COUNT] = LOG_LINE
    HISTORY_COUNT = HISTORY_COUNT + 1
endif
return

; ============================================
; サブルーチン: 終了時サマリー表示 + ファイル保存
; ============================================
:show_summary
if HISTORY_COUNT == 0 then
    messagebox '実行したコマンドはありませんでした。' '作業サマリー'
    end
endif

SUMMARY_TEXT = ''
i = 0
:summary_loop
strconcat SUMMARY_TEXT HISTORY_LINES[i]
strconcat SUMMARY_TEXT '\n'
i = i + 1
if i < HISTORY_COUNT goto summary_loop

strspecial SUMMARY_TEXT
messagebox SUMMARY_TEXT '作業サマリー'

gettime SUMMARY_FILE "%Y%m%d%H%M%S"
strconcat SUMMARY_FILE '_summary.log'
SAVE_PATH = 'P:\teraterm\bkup\'
strconcat SAVE_PATH SUMMARY_FILE

fileopen fhandle SAVE_PATH 0
i = 0
:save_loop
filewriteln fhandle HISTORY_LINES[i]
i = i + 1
if i < HISTORY_COUNT goto save_loop
fileclose fhandle

end
