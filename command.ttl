; ============================================================
; 1. 環境設定
; ============================================================
CMD_FILE    = 'P:\teraterm\commands.txt'       ; コマンド定義ファイル
LOG_FILE    = 'P:\teraterm\command_result.log' ; 出力ログファイル

JUMP_HOST   = '10.0.0.25'
JUMP_USER   = 'root'
JUMP_PASS   = 'nanahira'

TARGET_IP   = '10.0.0.21'
TARGET_USER = 'nanahira'
TARGET_PASS = 'nanahira'

; ============================================================
; 2. 定義ファイルの読み込み
; ============================================================
fileopen fhandle CMD_FILE 0
if fhandle == -1 then
    messagebox 'コマンド定義ファイルが見つかりません。' 'Error'
    end
endif

strdim COMMAND_LIST 20 
count = 0

:loop_file
filereadln fhandle line
if result then
    goto close_file
endif

strlen line
if result > 0 then
    COMMAND_LIST[count] = line
    count = count + 1
endif

if count < 20 goto loop_file

:close_file
fileclose fhandle

if count == 0 then
    messagebox '実行可能なコマンドが登録されていません。' 'Error'
    end
endif

; ============================================================
; 3. メニュー表示
; ============================================================
listbox '実行するコマンドを選択してください' 'External Command Menu' COMMAND_LIST

if result == -1 then
    end
endif
SELECTED_CMD = COMMAND_LIST[result]

; ============================================================
; 4. 接続処理
; ============================================================
COMMAND = JUMP_HOST
strconcat COMMAND ':22 /ssh /2 /auth=password /user='
strconcat COMMAND JUMP_USER
strconcat COMMAND ' /passwd='
strconcat COMMAND JUMP_PASS

connect COMMAND
if result <> 2 then
    messagebox '接続に失敗しました。' 'Error'
    end
endif

timeout = 10
wait '#' '$' '>'

sendln 'ssh ' TARGET_USER '@' TARGET_IP
wait 'password:'
sendln TARGET_PASS
wait '#' '$' '>'

; ============================================================
; 5. ログ記録とコマンド実行
; ============================================================
logclose
filedelete LOG_FILE

flushrecv
logopen LOG_FILE 0 0
mpause 200

sendln SELECTED_CMD

wait '#' '$' '>'

pause 1
logclose

; ============================================================
; 6. 終了処理（順次ログアウトしてTera Termを閉じる）
; ============================================================
; 1. ターゲットサーバからログアウト
sendln 'exit'
wait '#' '$' '>'

; 2. 踏み台サーバからログアウト
sendln 'exit'

; 3. Tera Term自体を終了させる
closett

end